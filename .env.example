# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: restrict access ─────────────────────────────────────────────────
# Comma-separated Telegram user IDs. Leave blank to allow all users.
# Get your user ID by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# ── Optional: CryptoPanic (extra news source) ─────────────────────────────────
# Register free at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# ── Optional: scheduled automatic scans ───────────────────────────────────────
SCHEDULE_ENABLED=false
SCHEDULE_CHAT_ID=          # Telegram chat ID to send scheduled reports to
SCHEDULE_TIME=08:00        # Daily scan time in HH:MM UTC
